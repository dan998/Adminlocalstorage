// =====================================================
// FILE ROUTER
// =====================================================

function handleFileRoutes(
  action,
  data
) {

  // ===================================================
  // UPLOAD FILE
  // ===================================================

  if (
    action ===
    "uploadFile"
  ) {

    return uploadFile(
      data
    );

  }


  // ===================================================
  // GET FILES
  // ===================================================

  if (
    action ===
    "getFiles"
  ) {

    return getFiles(
      data
    );

  }


  // ===================================================
  // GET SINGLE FILE
  // ===================================================

  if (
    action ===
    "getFile"
  ) {

    return getFile(
      data
    );

  }


  // ===================================================
  // DELETE FILE
  // ===================================================

  if (
    action ===
    "deleteFile"
  ) {

    return deleteFile(
      data
    );

  }


  // ===================================================
  // UPDATE FILE INFORMATION
  // ===================================================

  if (
    action ===
    "updateFileInfo"
  ) {

    return updateFileInfo(
      data
    );

  }


  // ===================================================
  // CHECK UPLOAD LIMIT
  // ===================================================

  if (
    action ===
    "checkUploadLimit"
  ) {

    return checkUploadLimit(
      data
    );

  }


  // ===================================================
  // NO FILE ROUTE
  // ===================================================

  return null;

}