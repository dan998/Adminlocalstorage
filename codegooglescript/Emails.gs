// ===================================================== // EMAIL.GS // Core Email Configuration, Constants & Helpers // Registration System API // ===================================================== // ===================================================== // EMAIL SHEET // ===================================================== const EMAIL_SHEET = "EMAILS"; // ===================================================== // EMAIL SHEETS // ===================================================== const EMAIL_SHEETS = { EMAILS: "EMAILS", QUEUE: "EMAIL_QUEUE", LOGS: "EMAIL_LOGS", BROADCASTS: "EMAIL_BROADCASTS" }; // ===================================================== // EMAIL STATUSES // ===================================================== const EMAIL_STATUSES = { PENDING: "Pending", QUEUED: "Queued", PROCESSING: "Processing", SENT: "Sent", FAILED: "Failed", RETRY: "Retry", CANCELLED: "Cancelled", EXPIRED: "Expired", OPENED: "Opened", CLICKED: "Clicked" }; // ===================================================== // EMAIL TYPES // ===================================================== const EMAIL_TYPES = { VERIFICATION: "Verification", PASSWORD_RESET: "Password Reset", WELCOME: "Welcome", LOGIN_ALERT: "Login Alert", LOGOUT_ALERT: "Logout Alert", SECURITY_ALERT: "Security Alert", ACCOUNT: "Account", DEPOSIT: "Deposit", WITHDRAWAL: "Withdrawal", BET: "Bet", ADMIN: "Admin", SUPPORT: "Support", BULK: "Bulk", BROADCAST: "Broadcast", NOTIFICATION: "Notification", SYSTEM: "System" }; // ===================================================== // EMAIL PRIORITIES // ===================================================== const EMAIL_PRIORITIES = { LOW: "Low", NORMAL: "Normal", HIGH: "High", URGENT: "Urgent" }; // ===================================================== // EMAIL ACTIONS // ===================================================== const EMAIL_ACTIONS = { CREATED: "Created", QUEUED: "Queued", PROCESSING: "Processing", SENT: "Sent", FAILED: "Failed", RETRIED: "Retried", CANCELLED: "Cancelled", EXPIRED: "Expired", OPENED: "Opened", CLICKED: "Clicked", DELETED: "Deleted" }; // ===================================================== // EMAIL PROVIDERS // ===================================================== const EMAIL_PROVIDERS = { MAILAPP: "MailApp", GMAILAPP: "GmailApp" }; // ===================================================== // EMAIL COLUMNS // ===================================================== const EMAIL_COLUMNS = { ID: 1, USER_ID: 2, RECIPIENT: 3, EMAIL: 3, TYPE: 4, SUBJECT: 5, MESSAGE: 6, STATUS: 7, PRIORITY: 8, QUEUE_ID: 9, ATTEMPTS: 10, MAX_ATTEMPTS: 11, CREATED_DATE: 12, QUEUED_DATE: 13, SENT_DATE: 14, FAILED_DATE: 15, ERROR_MESSAGE: 16, OPENED_DATE: 17, CLICKED_DATE: 18, CREATED_BY: 19, UPDATED_DATE: 20 }; // ===================================================== // EMAIL QUEUE COLUMNS // ===================================================== const EMAIL_QUEUE_COLUMNS = { ID: 1, EMAIL_ID: 2, RECIPIENT: 3, PRIORITY: 4, ATTEMPTS: 5, MAX_ATTEMPTS: 6, STATUS: 7, NEXT_RETRY: 8, LOCKED: 9, LOCKED_AT: 10, CREATED_DATE: 11, PROCESSED_DATE: 12, ERROR_MESSAGE: 13 }; // ===================================================== // EMAIL LOG COLUMNS // ===================================================== const EMAIL_LOG_COLUMNS = { ID: 1, EMAIL_ID: 2, USER_ID: 3, ACTION: 4, STATUS: 5, RECIPIENT: 6, ERROR_MESSAGE: 7, IP_ADDRESS: 8, USER_AGENT: 9, CREATED_BY: 10, CREATED_DATE: 11 }; // ===================================================== // EMAIL BROADCAST COLUMNS // ===================================================== const EMAIL_BROADCAST_COLUMNS = { ID: 1, SUBJECT: 2, MESSAGE: 3, TYPE: 4, PRIORITY: 5, RECIPIENT_TYPE: 6, RECIPIENT_COUNT: 7, SENT_COUNT: 8, FAILED_COUNT: 9, STATUS: 10, CREATED_BY: 11, CREATED_DATE: 12, STARTED_DATE: 13, COMPLETED_DATE: 14, ERROR_MESSAGE: 15 }; // ===================================================== // EMAIL SETTINGS // ===================================================== const EMAIL_SETTINGS = { ENABLED: true, LOG_EMAILS: true, QUEUE_ENABLED: true, BROADCAST_ENABLED: true, TRACK_EMAILS: true, MAX_RECIPIENTS: 500, MAX_BULK_RECIPIENTS: 500, MAX_BROADCAST_RECIPIENTS: 500, MAX_SUBJECT_LENGTH: 200, MAX_MESSAGE_LENGTH: 50000, RETRY_ATTEMPTS: 3, RETRY_DELAY_SECONDS: 30, QUEUE_BATCH_SIZE: 20, QUEUE_LOCK_MINUTES: 10, LOG_RETENTION_DAYS: 90, QUEUE_RETENTION_DAYS: 30 }; // ===================================================== // EMAIL FEATURE FLAGS // ===================================================== const EMAIL_FEATURES = { VERIFICATION: true, PASSWORD_RESET: true, WELCOME: true, LOGIN_ALERT: true, SECURITY_ALERT: true, DEPOSIT: true, WITHDRAWAL: true, SUPPORT: true, BROADCAST: true, QUEUE: true, ANALYTICS: true, LOGGING: true }; // ===================================================== // GET EMAIL SHEET // ===================================================== function getEmailsSheet() { return getSheet( SHEETS.EMAILS || EMAIL_SHEET ); } // ===================================================== // GET EMAIL QUEUE SHEET // ===================================================== function getEmailQueueSheet() { return getSheet( EMAIL_SHEETS.QUEUE ); } // ===================================================== // GET EMAIL LOG SHEET // ===================================================== function getEmailLogsSheet() { return getSheet( EMAIL_SHEETS.LOGS ); } // ===================================================== // GET EMAIL BROADCAST SHEET // ===================================================== function getEmailBroadcastSheet() { return getSheet( EMAIL_SHEETS.BROADCASTS ); } // ===================================================== // GENERATE EMAIL ID // ===================================================== function generateEmailId() { return ( "EMAIL-" + Utilities.getUuid() .replace(/-/g, "") .substring(0, 12) .toUpperCase() ); } // ===================================================== // GENERATE EMAIL QUEUE ID // ===================================================== function generateEmailQueueId() { return ( "QUEUE-" + Utilities.getUuid() .replace(/-/g, "") .substring(0, 12) .toUpperCase() ); } // ===================================================== // GENERATE EMAIL LOG ID // ===================================================== function generateEmailLogId() { return ( "ELOG-" + Utilities.getUuid() .replace(/-/g, "") .substring(0, 12) .toUpperCase() ); } // ===================================================== // GENERATE BROADCAST ID // ===================================================== function generateEmailBroadcastId() { return ( "BROADCAST-" + Utilities.getUuid() .replace(/-/g, "") .substring(0, 12) .toUpperCase() ); } // ===================================================== // CHECK EMAIL SYSTEM // ===================================================== function isEmailEnabled() { return ( EMAIL_SETTINGS.ENABLED === true ); } // ===================================================== // CHECK EMAIL QUEUE // ===================================================== function isEmailQueueEnabled() { return ( EMAIL_SETTINGS.ENABLED === true && EMAIL_SETTINGS.QUEUE_ENABLED === true && EMAIL_FEATURES.QUEUE === true ); } // ===================================================== // CHECK BROADCAST // ===================================================== function isEmailBroadcastEnabled() { return ( EMAIL_SETTINGS.ENABLED === true && EMAIL_SETTINGS.BROADCAST_ENABLED === true && EMAIL_FEATURES.BROADCAST === true ); } // ===================================================== // CHECK EMAIL FEATURE // ===================================================== function isEmailFeatureEnabled( feature ) { if (!feature) { return false; } return ( EMAIL_FEATURES[ feature ] === true ); } // ===================================================== // VALIDATE EMAIL TYPE // ===================================================== function isValidEmailType( type ) { return ( Object.values( EMAIL_TYPES ).indexOf( type ) !== -1 ); } // ===================================================== // VALIDATE EMAIL STATUS // ===================================================== function isValidEmailStatus( status ) { return ( Object.values( EMAIL_STATUSES ).indexOf( status ) !== -1 ); } // ===================================================== // VALIDATE EMAIL PRIORITY // ===================================================== function isValidEmailPriority( priority ) { return ( Object.values( EMAIL_PRIORITIES ).indexOf( priority ) !== -1 ); } // ===================================================== // VALIDATE EMAIL ADDRESS // ===================================================== function isValidEmailAddress( email ) { if (!email) { return false; } const value = String(email) .trim(); const pattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/; return pattern.test( value ); } // ===================================================== // VALIDATE EMAIL SUBJECT // ===================================================== function validateEmailSubject( subject ) { if (!subject) { throw new Error( "Email subject is required" ); } subject = String(subject); if ( subject.length > EMAIL_SETTINGS.MAX_SUBJECT_LENGTH ) { throw new Error( "Email subject exceeds maximum length" ); } return true; } // ===================================================== // VALIDATE EMAIL MESSAGE // ===================================================== function validateEmailMessage( message ) { if ( message === null || message === undefined || String(message).trim() === "" ) { throw new Error( "Email message is required" ); } if ( String(message).length > EMAIL_SETTINGS.MAX_MESSAGE_LENGTH ) { throw new Error( "Email message exceeds maximum length" ); } return true; } // ===================================================== // VALIDATE RECIPIENT COUNT // ===================================================== function validateEmailRecipientCount( count ) { count = Number(count); if ( count <= 0 ) { throw new Error( "At least one recipient is required" ); } if ( count > EMAIL_SETTINGS.MAX_RECIPIENTS ) { throw new Error( "Maximum email recipient limit exceeded" ); } return true; } // ===================================================== // NORMALIZE EMAIL // ===================================================== function normalizeEmail( email ) { if (!email) { return ""; } return String(email) .trim() .toLowerCase(); } // ===================================================== // NORMALIZE RECIPIENTS // ===================================================== function normalizeEmailRecipients( recipients ) { if (!recipients) { return []; } let list; if ( Array.isArray( recipients ) ) { list = recipients; } else { list = String(recipients) .split(","); } const result = []; list.forEach( function(email) { const normalized = normalizeEmail( email ); if ( normalized && result.indexOf( normalized ) === -1 ) { result.push( normalized ); } } ); return result; } // ===================================================== // VALIDATE RECIPIENTS // ===================================================== function validateEmailRecipients( recipients ) { const emails = normalizeEmailRecipients( recipients ); if ( emails.length === 0 ) { throw new Error( "No email recipients provided" ); } validateEmailRecipientCount( emails.length ); for ( let i = 0; i < emails.length; i++ ) { if ( !isValidEmailAddress( emails[i] ) ) { throw new Error( "Invalid email address: " + emails[i] ); } } return emails; } // ===================================================== // CREATE EMAIL RECORD // ===================================================== function createEmailRecord( emailData ) { emailData = emailData || {}; const recipient = normalizeEmail( emailData.email || emailData.recipient ); if (!recipient) { throw new Error( "Email recipient is required" ); } validateEmailRecipients( recipient ); validateEmailSubject( emailData.subject ); validateEmailMessage( emailData.message ); const type = emailData.type || EMAIL_TYPES.NOTIFICATION; if ( !isValidEmailType( type ) ) { throw new Error( "Invalid email type" ); } const priority = emailData.priority || EMAIL_PRIORITIES.NORMAL; if ( !isValidEmailPriority( priority ) ) { throw new Error( "Invalid email priority" ); } const sheet = getEmailsSheet(); const emailId = generateEmailId(); const now = new Date(); sheet.appendRow([ emailId, emailData.userId || "", recipient, type, String( emailData.subject ), String( emailData.message ), EMAIL_STATUSES.PENDING, priority, emailData.queueId || "", 0, emailData.maxAttempts || EMAIL_SETTINGS.RETRY_ATTEMPTS, now, emailData.queuedDate || "", "", "", "", "", "", emailData.createdBy || "", now ]); return emailId; } // ===================================================== // UPDATE EMAIL RECORD // ===================================================== function updateEmailRecord( emailId, updates ) { if (!emailId) { throw new Error( "Email ID is required" ); } updates = updates || {}; const sheet = getEmailsSheet(); const data = sheet.getDataRange() .getValues(); if ( data.length < 2 ) { throw new Error( "Email record not found" ); } for ( let i = 1; i < data.length; i++ ) { if ( String( data[i][ EMAIL_COLUMNS.ID - 1 ] ) === String(emailId) ) { const row = i + 1; const allowedColumns = [ "USER_ID", "RECIPIENT", "TYPE", "SUBJECT", "MESSAGE", "STATUS", "PRIORITY", "QUEUE_ID", "ATTEMPTS", "MAX_ATTEMPTS", "QUEUED_DATE", "SENT_DATE", "FAILED_DATE", "ERROR_MESSAGE", "OPENED_DATE", "CLICKED_DATE", "CREATED_BY" ]; allowedColumns.forEach( function(column) { if ( Object.prototype .hasOwnProperty.call( updates, column ) ) { const columnNumber = EMAIL_COLUMNS[ column ]; if ( columnNumber ) { sheet.getRange( row, columnNumber ).setValue( updates[ column ] ); } } } ); sheet.getRange( row, EMAIL_COLUMNS.UPDATED_DATE ).setValue( new Date() ); return true; } } throw new Error( "Email record not found" ); } // ===================================================== // UPDATE EMAIL STATUS // ===================================================== function updateEmailStatus( emailId, status, errorMessage ) { if ( !isValidEmailStatus( status ) ) { throw new Error( "Invalid email status" ); } const updates = { STATUS: status }; if ( errorMessage ) { updates.ERROR_MESSAGE = String( errorMessage ); } const now = new Date(); if ( status === EMAIL_STATUSES.SENT ) { updates.SENT_DATE = now; } if ( status === EMAIL_STATUSES.FAILED ) { updates.FAILED_DATE = now; } return updateEmailRecord( emailId, updates ); } // ===================================================== // GET EMAIL CONFIGURATION // ===================================================== function getEmailConfig() { return { enabled: EMAIL_SETTINGS.ENABLED, queueEnabled: EMAIL_SETTINGS.QUEUE_ENABLED, broadcastEnabled: EMAIL_SETTINGS.BROADCAST_ENABLED, loggingEnabled: EMAIL_SETTINGS.LOG_EMAILS, trackingEnabled: EMAIL_SETTINGS.TRACK_EMAILS, statuses: EMAIL_STATUSES, types: EMAIL_TYPES, priorities: EMAIL_PRIORITIES, actions: EMAIL_ACTIONS, providers: EMAIL_PROVIDERS, features: EMAIL_FEATURES, settings: EMAIL_SETTINGS }; } // ===================================================== // GET EMAIL SETTINGS // ===================================================== function getEmailSettings() { return EMAIL_SETTINGS; } // ===================================================== // GET EMAIL FEATURES // ===================================================== function getEmailFeatures() { return EMAIL_FEATURES; } // ===================================================== // GET EMAIL TYPES // ===================================================== function getEmailTypes() { return EMAIL_TYPES; } // ===================================================== // GET EMAIL STATUSES // ===================================================== function getEmailStatuses() { return EMAIL_STATUSES; } // ===================================================== // GET EMAIL PRIORITIES // ===================================================== function getEmailPriorities() { return EMAIL_PRIORITIES; } 